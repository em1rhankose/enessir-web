# Caddy: domain için HTTPS sertifikasını otomatik alır ve yeniler, isteği siteye iletir.
# DOMAIN .env dosyasından gelir (örn. enessir.com).

{$DOMAIN} {
	# Sayfaları sıkıştırarak gönder (daha hızlı yükleme).
	encode zstd gzip

	reverse_proxy app:3000
}

# www.enessir.com -> enessir.com
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
