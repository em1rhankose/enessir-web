# Sunucuda bu dosyayı .env adıyla kopyalayıp doldurun:  cp .env.production.example .env
# Bu dosya GitHub'a gönderilmez; şifreleri kimseyle paylaşmayın.
# Boşluk içeren değerleri çift tırnak içine yazın (örn. SMTP_FROM_NAME="Psikolog Enes Sir").

# Sitenin domain'i (https:// olmadan). Caddy bunun için HTTPS sertifikası alır.
DOMAIN=enessir.com
NEXT_PUBLIC_SERVER_URL=https://enessir.com

# Veritabanı şifresi: uzun ve rastgele olsun. Örn: openssl rand -hex 24
POSTGRES_PASSWORD=BURAYA_UZUN_RASTGELE_SIFRE
# Site çalışırken veritabanına Docker ağı içinden bağlanır (host: db).
DATABASE_URL=postgres://enessir:BURAYA_UZUN_RASTGELE_SIFRE@db:5432/enessir
# İmaj derlenirken sayfalar üretilir; o sırada veritabanına sunucunun kendisinden bağlanılır.
BUILD_DATABASE_URL=postgres://enessir:BURAYA_UZUN_RASTGELE_SIFRE@127.0.0.1:5432/enessir

# Oturum şifreleme anahtarı: uzun ve rastgele. Örn: openssl rand -hex 32
PAYLOAD_SECRET=BURAYA_UZUN_RASTGELE_ANAHTAR

# E-posta (iletişim formu bildirimi). Boş bırakılırsa e-posta gönderilmez.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME="Psikolog Enes Sir"

# Kaç günlük yedek saklansın.
BACKUP_KEEP_DAYS=14
