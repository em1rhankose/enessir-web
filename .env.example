# Veritabanı. Geliştirmede yerel SQLite dosyası; canlıda PostgreSQL bağlantı adresi kullanılacak.
DATABASE_URL=file:./enessir.db

# Oturumları şifrelemek için uzun, rastgele bir metin. Örn: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Sitenin tam adresi; SEO etiketleri ve site haritası için. Canlıda örn. https://enessir.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
